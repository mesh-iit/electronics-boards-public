                                           ;                                                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\scpyp2r.asm
                                           ; char *strcpypgm2ram (char *s1, const rom char *s2);                            C:\MCC18\SRC\TRADIT~1\STDCLIB\scpyp2r.asm
