                                           braFgeF macro   Var1,Var2,jLabel                                                C:\MCC18\SRC\TRADIT~1\MATH\fpmacros.inc
                                                   movf    Var2,W                                                          C:\MCC18\SRC\TRADIT~1\MATH\fpmacros.inc
