                                                                                                                            D:\PICs\ControlBoard\autofiles\usbdsc.c
                                           /*********************************************************************           D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * -usbdsc.c-                                                                    D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * This file contains the USB descriptor information. It is used                 D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * in conjunction with the usbdsc.h file. When a descriptor is added             D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * or removed from the main configuration descriptor, i.e. CFG01,                D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * the user must also change the descriptor structure defined in                 D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * the usbdsc.h file. The structure is used to calculate the                     D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * descriptor size, i.e. sizeof(CFG01).                                          D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * A typical configuration descriptor consists of:                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * At least one configuration descriptor (USB_CFG_DSC)                           D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * One or more interface descriptors (USB_INTF_DSC)                              D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * One or more endpoint descriptors (USB_EP_DSC)                                 D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * Naming Convention:                                                            D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * To resolve ambiguity, the naming convention are as followed:                  D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * - USB_CFG_DSC type should be named cdxx, where xx is the                      D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *   configuration number. This number should match the actual                   D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *   index value of this configuration.                                          D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * - USB_INTF_DSC type should be named i<yy>a<zz>, where yy is the               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *   interface number and zz is the alternate interface number.                  D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * - USB_EP_DSC type should be named ep<##><d>_i<yy>a<zz>, where                 D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *   ## is the endpoint number and d is the direction of transfer.               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *   The interface name should also be listed as a suffix to identify            D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *   which interface does the endpoint belong to.                                D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * Example:                                                                      D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * If a device has one configuration, two interfaces; interface 0                D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * has two endpoints (in and out), and interface 1 has one endpoint(in).         D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * Then the CFG01 structure in the usbdsc.h should be:                           D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * #define CFG01 rom struct                            \                         D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * {   USB_CFG_DSC             cd01;                   \                         D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *     USB_INTF_DSC            i00a00;                 \                         D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *     USB_EP_DSC              ep01o_i00a00;           \                         D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *     USB_EP_DSC              ep01i_i00a00;           \                         D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *     USB_INTF_DSC            i01a00;                 \                         D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *     USB_EP_DSC              ep02i_i01a00;           \                         D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * } cfg01                                                                       D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * Note the hierarchy of the descriptors above, it follows the USB               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * specification requirement. All endpoints belonging to an interface            D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * should be listed immediately after that interface.                            D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * -------------------------------------------------------------------           D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * Filling in the descriptor values in the usbdsc.c file:                        D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * -------------------------------------------------------------------           D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * Most items should be self-explanatory, however, a few will be                 D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * explained for clarification.                                                  D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * [Configuration Descriptor(USB_CFG_DSC)]                                       D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * The configuration attribute must always have the _DEFAULT                     D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * definition at the minimum. Additional options can be ORed                     D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * to the _DEFAULT attribute. Available options are _SELF and _RWU.              D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * These definitions are defined in the usbdefs_std_dsc.h file. The              D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * _SELF tells the USB host that this device is self-powered. The                D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * _RWU tells the USB host that this device supports Remote Wakeup.              D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * [Endpoint Descriptor(USB_EP_DSC)]                                             D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * Assume the following example:                                                 D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * sizeof(USB_EP_DSC),DSC_EP,_EP01_OUT,_BULK,64,0x00                             D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * The first two parameters are self-explanatory. They specify the               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * length of this endpoint descriptor (7) and the descriptor type.               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * The next parameter identifies the endpoint, the definitions are               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * defined in usbdefs_std_dsc.h and has the following naming                     D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * convention:                                                                   D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * _EP<##>_<dir>                                                                 D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * where ## is the endpoint number and dir is the direction of                   D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * transfer. The dir has the value of either 'OUT' or 'IN'.                      D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * The next parameter identifies the type of the endpoint. Available             D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * options are _BULK, _INT, _ISO, and _CTRL. The _CTRL is not                    D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * typically used because the default control transfer endpoint is               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * not defined in the USB descriptors. When _ISO option is used,                 D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * addition options can be ORed to _ISO. Example:                                D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * _ISO|_AD|_FE                                                                  D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * This describes the endpoint as an isochronous pipe with adaptive              D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * and feedback attributes. See usbdefs_std_dsc.h and the USB                    D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * specification for details. The next parameter defines the size of             D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * the endpoint. The last parameter in the polling interval.                     D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * -------------------------------------------------------------------           D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * Adding a USB String                                                           D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * -------------------------------------------------------------------           D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * A string descriptor array should have the following format:                   D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * rom struct{byte bLength;byte bDscType;word string[size];}sdxxx={              D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * sizeof(sdxxx),DSC_STR,<text>};                                                D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * The above structure provides a means for the C compiler to                    D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * calculate the length of string descriptor sdxxx, where xxx is the             D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * index number. The first two bytes of the descriptor are descriptor            D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * length and type. The rest <text> are string texts which must be               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * in the unicode format. The unicode format is achieved by declaring            D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * each character as a word type. The whole text string is declared              D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * as a word array with the number of characters equals to <size>.               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * <size> has to be manually counted and entered into the array                  D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * declaration. Let's study this through an example:                             D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * if the string is "USB" , then the string descriptor should be:                D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * (Using index 02)                                                              D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * rom struct{byte bLength;byte bDscType;word string[3];}sd002={                 D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * sizeof(sd002),DSC_STR,'U','S','B'};                                           D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * A USB project may have multiple strings and the firmware supports             D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * the management of multiple strings through a look-up table.                   D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * The look-up table is defined as:                                              D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * rom const unsigned char *rom USB_SD_Ptr[]={&sd000,&sd001,&sd002};             D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * The above declaration has 3 strings, sd000, sd001, and sd002.                 D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * Strings can be removed or added. sd000 is a specialized string                D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * descriptor. It defines the language code, usually this is                     D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * US English (0x0409). The index of the string must match the index             D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * position of the USB_SD_Ptr array, &sd000 must be in position                  D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * USB_SD_Ptr[0], &sd001 must be in position USB_SD_Ptr[1] and so on.            D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * The look-up table USB_SD_Ptr is used by the get string handler                D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * function in usb9.c.                                                           D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            *                                                                               D:\PICs\ControlBoard\autofiles\usbdsc.c
                                            * -------------------------------------------------------------------           D:\PICs\ControlBoard\autofiles\usbdsc.c
