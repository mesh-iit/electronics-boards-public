000b14   e1ea     BNZ       0xaea                    bnz       jUnpkNaN           ; NaN                                    C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
                                                                                                                           C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
                                                     ;; infinity                                                           C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
000b16   8a0f     BSF       0xf,0x5,0x0              bsf       fFlg,FLG_INF_B      ; B: is infinity                        C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
