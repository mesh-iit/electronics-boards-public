                                           jUnpkNaN:                                                                       C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
                                                     ;; either A or B is a NaN                                             C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
000aea   860f     BSF       0xf,0x3,0x0              bsf       fFlg,FLG_NaN_AorB   ; Signal NaN for A or B                 C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
000aec   0012     RETURN    0x0                      return                                                                C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
