                                                * for EP0_IN will then be forced back to CPU by firmware.                   D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                */                                                                          D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001950   a070     BTFSS     0x70,0x0,0x0       if(UEP0bits.EPSTALL == 1)                                                    D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
