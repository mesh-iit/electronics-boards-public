                                           ;; Start with form 0.f * 0.f                                                    C:\MCC18\SRC\TRADIT~1\MATH\mulFP.asm
                                           ;; Results can be fW0 = 11xxxxxx -> 01xxxxxx                                    C:\MCC18\SRC\TRADIT~1\MATH\mulFP.asm
