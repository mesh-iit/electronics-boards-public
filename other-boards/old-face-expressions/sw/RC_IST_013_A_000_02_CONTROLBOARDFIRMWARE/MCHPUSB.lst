                                                       /*                                                                   D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * 2. Prepare IN EP to transfer data, Cnt should have                D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
