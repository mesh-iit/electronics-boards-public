                                                     GLOBAL INT3208                                                        C:\MCC18\SRC\TRADIT~1\MATH\castFP08.asm
                                                                                                                           C:\MCC18\SRC\TRADIT~1\MATH\castFP08.asm
                                                     EXTERN __FpUnPackA                                                    C:\MCC18\SRC\TRADIT~1\MATH\castFP08.asm
                                                                                                                           C:\MCC18\SRC\TRADIT~1\MATH\castFP08.asm
                                           PROG    CODE                                                                    C:\MCC18\SRC\TRADIT~1\MATH\castFP08.asm
