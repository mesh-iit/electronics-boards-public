                                           /******************************************************************************  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Function:        void USBCheckBusStatus(void)                                 D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * PreCondition:    None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Input:           None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Output:          None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Side Effects:    None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Overview:        This routine enables/disables the USB module by monitoring   D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  the USB power signal.                                        D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Note:            None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *****************************************************************************/  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                           void USBCheckBusStatus(void)                                                     D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                           {                                                                                D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                               /**************************************************************************  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                * Bus Attachment & Detachment Detection                                     D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                * usb_bus_sense is an i/o pin defined in io_cfg.h                           D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                *************************************************************************/  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                               #define USB_BUS_ATTACHED    1                                                D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                               #define USB_BUS_DETACHED    0                                                D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                               if(usb_bus_sense == USB_BUS_ATTACHED)       // Is USB bus attached?          D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                               {                                                                            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001862   a66d     BTFSS     0x6d,0x3,0x0           if(UCONbits.USBEN == 0)                 // Is the module off?            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001864   d80f     RCALL     0x1884                     USBModuleEnable();                  // Is off, enable it             D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                               }                                                                            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001866   d002     BRA       0x186c             else                                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                               {                                                                            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001868   b66d     BTFSC     0x6d,0x3,0x0           if(UCONbits.USBEN == 1)                 // Is the module on?             D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
00186a   d813     RCALL     0x1892                     USBModuleDisable();                 // Is on, disable it             D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                               }//end if(usb_bus_sense...)                                                  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                               /*                                                                           D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                * After enabling the USB module, it takes some time for the voltage         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                * on the D+ or D- line to rise high enough to get out of the SE0 condition. D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                * The USB Reset interrupt should not be unmasked until the SE0 condition is D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                * cleared. This helps preventing the firmware from misinterpreting this     D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                * unique event as a USB bus reset from the USB host.                        D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                */                                                                          D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
00186c   0100     MOVLB     0x0                if(usb_device_state == ATTACHED_STATE)                                       D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
00186e   05f9     DECF      0xf9,0x0,0x1                                                                                    
001870   e108     BNZ       0x1882                                                                                          
                                               {                                                                            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001872   ba6d     BTFSC     0x6d,0x5,0x0           if(!UCONbits.SE0)                                                        D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001874   d006     BRA       0x1882                                                                                          
                                                   {                                                                        D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001876   6a68     CLRF      0x68,0x0                   UIR = 0;                        // Clear all USB interrupts          D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001878   6a69     CLRF      0x69,0x0                   UIE = 0;                        // Mask all USB interrupts           D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
00187a   8069     BSF       0x69,0x0,0x0               UIEbits.URSTIE = 1;             // Unmask RESET interrupt            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
00187c   8869     BSF       0x69,0x4,0x0               UIEbits.IDLEIE = 1;             // Unmask IDLE interrupt             D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
00187e   0e02     MOVLW     0x2                        usb_device_state = POWERED_STATE;                                    D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001880   6ff9     MOVWF     0xf9,0x1                                                                                        
                                                   }//end if                           // else wait until SE0 is cleared    D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                               }//end if(usb_device_state == ATTACHED_STATE)                                D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001882   0012     RETURN    0x0            }//end USBCheckBusStatus                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                           /******************************************************************************  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Function:        void USBModuleEnable(void)                                   D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * PreCondition:    None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Input:           None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Output:          None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Side Effects:    None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Overview:        This routine enables the USB module.                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  An end designer should never have to call this routine       D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  manually. This routine should only be called from            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  USBCheckBusStatus().                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Note:            See USBCheckBusStatus() for more information.                D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *****************************************************************************/  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                           void USBModuleEnable(void)                                                       D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                           {                                                                                D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001884   6a6d     CLRF      0x6d,0x0           UCON = 0;                                                                    D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001886   6a69     CLRF      0x69,0x0           UIE = 0;                                // Mask all USB interrupts           D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
001888   866d     BSF       0x6d,0x3,0x0       UCONbits.USBEN = 1;                     // Enable module & attach to bus     D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
00188a   0100     MOVLB     0x0                usb_device_state = ATTACHED_STATE;      // Defined in usbmmap.c & .h         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
00188c   0e01     MOVLW     0x1                                                                                             
00188e   6ff9     MOVWF     0xf9,0x1                                                                                        
001890   0012     RETURN    0x0            }//end USBModuleEnable                                                           D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                           /******************************************************************************  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Function:        void USBModuleDisable(void)                                  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
