                                           /******************************************************************************  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * -usbmmap.c-                                                                   D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * USB Memory Map                                                                D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * This file is the USB memory manager; it serves as a compile-time memory       D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * allocator for the USB endpoints. It uses the compile time options passed      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * from usbcfg.h to instantiate endpoints and endpoint buffer.                   D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * Each endpoint requires to have a set of Buffer Descriptor registers(BDT).     D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * A BDT is 4-byte long and has a specific RAM location for each endpoint.       D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The BDT for endpoint 0 out is located at address 0x400 to 0x403.              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The BDT for endpoint 0 in is located at address 0x404 to 0x407.               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The BDT for endpoint 1 out is located at address 0x408 to 0x40B.              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * and so on... The above allocation assumes the Ping-Pong Buffer Mode 0 is      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * used. These locations are already hard-wired in the silicon. The point        D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * of doing instantiation, i.e. volatile far BDT ep0Bo;, is to provide the       D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * C compiler a way to address each variable directly. This is very important    D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * because when a register can be accessed directly, it saves execution time     D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * and reduces program size.                                                     D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * Endpoints are defined using the endpoint number and the direction             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * of transfer. For simplicity, usbmmap.c only uses the endpoint number          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * in the BDT register allocation scheme. This means if the usbcfg.h states      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * that the MAX_EP_NUMBER is number 1, then four BDTs will be                    D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * instantiated: one each for endpoint0 in and endpoint0 out, which must         D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * always be instantiated for control transfer by default, and one each sets     D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * for endpoint1 in and endpoint1 out. The naming convention for instantiating   D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * BDT is                                                                        D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * ep<#>B<d>                                                                     D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * where # is the endpoint number, and d is the direction of                     D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * transfer, which could be either <i> or <o>.                                   D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The USB memory manager uses MAX_EP_NUMBER, as defined in usbcfg.h, to define  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * the endpoints to be instantiated. This represents the highest endpoint        D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * number to be allocated, not how many endpoints are used. Since the BDTs for   D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * endpoints have hardware-assigned addresses in Bank 4, setting this value too  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * high may lead to inefficient use of data RAM. For example, if an application  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * uses only endpoints EP0 and EP4, then the MAX_EP_NUMBER is 4, and not 2.      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The in-between endpoint BDTs in this example (EP1, EP2, and EP3) go unused,   D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * and the 24 bytes of memory associated with them are wasted. It does not make  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * much sense to skip endpoints, but the final decision lies with the user.      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The next step is to assign the instantiated BDTs to different                 D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * USB functions. The firmware framework fundamentally assumes that every USB    D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * function should know which endpoint it is using, i.e., the default control    D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * transfer should know that it is using endpoint 0 in and endpoint 0 out.       D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * A HID class can choose which endpoint it wants to use, but once chosen, it    D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * should always know the number of the endpoint.                                D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The assignment of endpoints to USB functions is managed centrally             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * in usbcfg.h. This helps prevent the mistake of having more                    D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * than one USB function using the same endpoint. The "Endpoint Allocation"      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * section in usbcfg.h provides examples for how to map USB endpoints to USB     D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * functions.                                                                    D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * Quite a few things can be mapped in that section. There is no                 D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * one correct way to do the mapping and the user has the choice to              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * choose a method that is most suitable to the application.                     D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * Typically, however, a user will want to map the following for a given         D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * USB interface function:                                                       D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * 1. The USB interface ID                                                       D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * 2. The endpoint control registers (UEPn)                                      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * 3. The BDT registers (ep<#>B<d>)                                              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * 4. The endpoint size                                                          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * Example: Assume a USB device class "foo", which uses one out endpoint         D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *          of size 64-byte and one in endpoint of size 64-byte, then:           D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * #define FOO_INTF_ID          0x00                                             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * #define FOO_UEP              UEP1                                             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * #define FOO_BD_OUT           ep1Bo                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * #define FOO_BD_IN            ep1Bi                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * #define FOO_EP_SIZE          64                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The mapping above has chosen class "foo" to use endpoint 1.                   D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The names are arbitrary and can be anything other than FOO_??????.            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * For abstraction, the code for class "foo" should use the abstract             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * definitions of FOO_BD_OUT,FOO_BD_IN, and not ep1Bo or ep1Bi.                  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * Note that the endpoint size defined in the usbcfg.h file is again             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * used in the usbmmap.c file. This shows that the relationship between          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * the two files are tightly related.                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The endpoint buffer for each USB function must be located in the              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * dual-port RAM area and has to come after all the BDTs have been               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * instantiated. An example declaration is:                                      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * volatile far unsigned char[FOO_EP_SIZE] data;                                 D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * The 'volatile' keyword tells the compiler not to perform any code             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * optimization on this variable because its content could be modified           D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * by the hardware. The 'far' keyword tells the compiler that this variable      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * is not located in the Access RAM area (0x000 - 0x05F).                        D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * For the variable to be globally accessible by other files, it should be       D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * declared in the header file usbmmap.h as an extern definition, such as        D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * extern volatile far unsigned char[FOO_EP_SIZE] data;                          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * Conclusion:                                                                   D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * In a short summary, the dependencies between usbcfg and usbmmap can           D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * be shown as:                                                                  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * usbcfg[MAX_EP_NUMBER] -> usbmmap                                              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * usbmmap[ep<#>B<d>] -> usbcfg                                                  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * usbcfg[EP size] -> usbmmap                                                    D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * usbcfg[abstract ep definitions] -> usb9/hid/cdc/etc class code                D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * usbmmap[endpoint buffer variable] -> usb9/hid/cdc/etc class code              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * Data mapping provides a means for direct addressing of BDT and endpoint       D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * buffer. This means less usage of pointers, which equates to a faster and      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * smaller program code.                                                         D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *****************************************************************************/  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           /** I N C L U D E S **********************************************************/  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #include "system\typedefs.h"                                                     D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #include "system\usb\usb.h"                                                      D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           /** U S B  G L O B A L  V A R I A B L E S ************************************/  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #pragma udata                                                                    D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           byte usb_device_state;          // Device States: DETACHED, ATTACHED, ...        D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           USB_DEVICE_STATUS usb_stat;     // Global USB flags                              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           byte usb_active_cfg;            // Value of current configuration                D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           byte usb_alt_intf[MAX_NUM_INT]; // Array to keep track of the current alternate  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                           // setting for each interface ID                 D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           /** U S B  F I X E D  L O C A T I O N  V A R I A B L E S *********************/  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #pragma udata usbram4=0x400     //See Linker Script,usb4:0x400-0x4FF(256-byte)   D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           /******************************************************************************  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * Section A: Buffer Descriptor Table                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * - 0x400 - 0x4FF(max)                                                          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * - MAX_EP_NUMBER is defined in autofiles\usbcfg.h                              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            * - BDT data type is defined in system\usb\usbmmap.h                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                            *****************************************************************************/  D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #if(0 <= MAX_EP_NUMBER)                                                          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep0Bo;         //Endpoint #0 BD Out                             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep0Bi;         //Endpoint #0 BD In                              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #endif                                                                           D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #if(1 <= MAX_EP_NUMBER)                                                          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep1Bo;         //Endpoint #1 BD Out                             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep1Bi;         //Endpoint #1 BD In                              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #endif                                                                           D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #if(2 <= MAX_EP_NUMBER)                                                          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep2Bo;         //Endpoint #2 BD Out                             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep2Bi;         //Endpoint #2 BD In                              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #endif                                                                           D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #if(3 <= MAX_EP_NUMBER)                                                          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep3Bo;         //Endpoint #3 BD Out                             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep3Bi;         //Endpoint #3 BD In                              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #endif                                                                           D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #if(4 <= MAX_EP_NUMBER)                                                          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep4Bo;         //Endpoint #4 BD Out                             D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep4Bi;         //Endpoint #4 BD In                              D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #endif                                                                           D:\PICs\ControlBoard\system\usb\usbmmap.c
                                                                                                                            D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           #if(5 <= MAX_EP_NUMBER)                                                          D:\PICs\ControlBoard\system\usb\usbmmap.c
                                           volatile far BDT ep5Bo;         //Endpoint #5 BD Out                             D:\PICs\ControlBoard\system\usb\usbmmap.c
