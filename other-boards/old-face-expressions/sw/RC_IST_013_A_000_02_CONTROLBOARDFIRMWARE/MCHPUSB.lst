                                           ; @name memcpypgm2ram                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ;The {\bf memcpypgm2ram} function performs a {\bf memcpy} where                  C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ;{\bf s1} points to data memory and {\bf s2} points to program                   C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ;memory.                                                                         C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ;@param s1 pointer to destination in data memory                                 C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ;@param s2 pointer to source in program memory                                   C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ;@param n number of characters to copy                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ;                                                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           STRING CODE                                                                      C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           memcpypgm2ram                                                                    C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                             global memcpypgm2ram                                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           #ifdef __SMALL__                                                                 C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                            messg "memcpypgm2ram - SMALL"                                                   C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ; Proceedure: Two byte pointers and two byte n.                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ;         Use offset from top of stack to test 'n' for zero and decrement        C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ;         it. Use FSR0 for 'dest' and TBLPTR for 'src'                           C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           ;         Assumes TBLPTRU = 0.                                                   C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                             ; Load TBLPTR with the 'src' pointer                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                     Stk2CpyToReg -4,TBLPTRL                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                             ; Load FSR0 with the 'dest' pointer                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                     Stk2CpyToReg -2,FSR0L                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                             ; make a copy for the return value                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           	movff FSR0L, PRODL                                                              C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           	movff FSR0H, PRODH                                                              C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           jLoop:                                                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                             ; Test 2 byte n for zero                                                       C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                     Stk2TestForZero -6,jEnd                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                             ; Decrement n                                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                     Stk2Dec   -6                                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                     tblrd     *+                  ; read & increment                       C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                     movff     TABLAT, POSTINC0                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                     bra       jLoop                                                        C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           jEnd                                                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                     return                                                                 C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           #else                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
                                           #ifdef __LARGE__                                                                 C:\MCC18\SRC\TRADIT~1\STDCLIB\mcpyp2r.asm
