                                           ;******************************************************************************* C:\MCC18\SRC\TRADIT~1\MATH\cmath18.asm
                                           ;   VARIABLE ALLOCATION - Core math library routines                            C:\MCC18\SRC\TRADIT~1\MATH\cmath18.asm
