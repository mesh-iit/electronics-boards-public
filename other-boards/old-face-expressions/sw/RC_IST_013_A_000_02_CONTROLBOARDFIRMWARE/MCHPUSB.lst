001ac2   fff3                                                                                                               
001ac4   cfea     MOVFF     0xfea,0xff4    	  movff FSR0H, PRODH                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
001ac6   fff4                                                                                                               
