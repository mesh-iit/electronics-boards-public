                                            * Output:          None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Side Effects:    None                                                         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Overview:        The STALLIF is set anytime the SIE sends out a STALL         D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  packet regardless of which endpoint causes it.               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  A Setup transaction overrides the STALL function. A stalled  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  endpoint stops stalling once it receives a setup packet.     D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  In this case, the SIE will accepts the Setup packet and      D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  set the TRNIF flag to notify the firmware. STALL function    D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  for that particular endpoint pipe will be automatically      D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  disabled (direction specific).                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  There are a few reasons for an endpoint to be stalled.       D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  1. When a non-supported USB request is received.             D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                     Example: GET_DESCRIPTOR(DEVICE_QUALIFIER)                 D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  2. When an endpoint is currently halted.                     D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  3. When the device class specifies that an endpoint must     D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                     stall in response to a specific event.                    D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                     Example: Mass Storage Device Class                        D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                              If the CBW is not valid, the device shall        D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                              STALL the Bulk-In pipe.                          D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                              See USB Mass Storage Class Bulk-only Transport   D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                              Specification for more details.                  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                                                                               D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            * Note:            UEPn.EPSTALL can be scanned to see which endpoint causes     D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  the stall event.                                             D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *                  If                                                           D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                            *****************************************************************************/  D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                           void USBStallHandler(void)                                                       D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
                                           {                                                                                D:\PICs\ControlBoard\system\usb\usbdrv\usbdrv.c
