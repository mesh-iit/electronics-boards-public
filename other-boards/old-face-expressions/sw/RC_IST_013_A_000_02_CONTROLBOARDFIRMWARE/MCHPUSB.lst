                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ; @name memset                                                                   C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;``The {\bf memset} function copies the value of {\bf c} [...] into              C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;each of the first {\bf n} characters of the object pointed to by                C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;{\bf s}.''                                                                      C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ; * The MPLAB-C18 version of the {\bf memset} function differs from the ANSI     C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;specified function in that {\bf c} is defined as an {\bf unsigned char}         C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;parameter rather than an {\bf int} parameter.                                   C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;Stack usage: 5 bytes. Re-entrant.                                               C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;@param s pointer to object                                                      C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;@param c character to copy into object                                          C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;@param n number of bytes of object to copy {\bf c} into                         C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;@return ``The {\bf memset} function returns the value of {\bf s}.''             C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;                                                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ; void *memset (void *s, unsigned char c, size_t n);                             C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           STRING CODE                                                                      C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           memset                                                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                             global memset                                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ; Proceedure: Use offset from top of stack to test 'n' for zero and decrement    C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           ;         it. Use FSR0 for 's'.                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                             ; Load FSR0 with the 's' pointer                                               C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                     Stk2CpyToReg -2,FSR0L                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                             ; Make a copy for the return value                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
001a78   cfe9     MOVFF     0xfe9,0xff3    	  movff FSR0L, PRODL                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
001a7a   fff3                                                                                                               
001a7c   cfea     MOVFF     0xfea,0xff4        	  movff FSR0H, PRODH                                                        C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
001a7e   fff4                                                                                                               
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           jLoop:                                                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                             ; Test n for zero                                                              C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                     Stk2TestForZero -5,jEnd                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                             ; Decrement n                                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                     Stk2Dec   -5                                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                             ; get 'c'                                                                      C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
001a96   0efd     MOVLW     0xfd                     movlw     -3                                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
001a98   50e3     MOVF      0xe3,0x0,0x0             movf      PLUSW1, W, ACCESS                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                             ; Store it in 's'                                                              C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
001a9a   6eee     MOVWF     0xee,0x0                 movwf     POSTINC0, ACCESS                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
001a9c   d7f1     BRA       0x1a80                   bra       jLoop                                                        C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                           jEnd                                                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
001a9e   0012     RETURN    0x0                      return                                                                 C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
                                             end                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memset.asm
