                                                                                                                           C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
                                                     ;; Negative                                                           C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
000af4   8c0f     BSF       0xf,0x6,0x0              bsf       fFlg,FLG_SIGN_B       ; Signal negative                     C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
000af6   7e0f     BTG       0xf,0x7,0x0              btg       fFlg,FLG_SIGN_ABW     ; Toggle combined sign                C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
                                           jUnpkB1:                                                                        C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
000af8   e106     BNZ       0xb06                    bnz       jUnpkBNZ                                                    C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
                                                                                                                           C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
                                                     ;; Zero exponent => Zero value or subnormal                           C:\MCC18\SRC\TRADIT~1\MATH\UnpackFP.asm
