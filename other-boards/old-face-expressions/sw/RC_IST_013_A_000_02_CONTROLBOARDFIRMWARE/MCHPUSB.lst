                                           ; @name strcpy                                                                   C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ;The {\bf strcpy} function copies the string pointed to by {\bf s2}              C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ;(including the terminating null character) into the array pointed to            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ;by {\bf s1}. If copying takes place between objects that overlap,               C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ;the behaviour is undefined.''                                                   C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ;Stack usage: 6 bytes. Re-entrant.                                               C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ;@param s1 pointer to destination                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ;@param s2 pointer to source                                                     C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ;@return ``The {\bf strcpy} function returns the value of {\bf s1}.''            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ;                                                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ; char *strcpy (char *dest, const char *src);                                    C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
