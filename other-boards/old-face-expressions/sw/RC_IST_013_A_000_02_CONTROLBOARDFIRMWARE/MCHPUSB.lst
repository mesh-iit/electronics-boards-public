                                                                                                                           C:\MCC18\SRC\TRADIT~1\MATH\castFP08.asm
                                           jMaxNeg:                                                                        C:\MCC18\SRC\TRADIT~1\MATH\castFP08.asm
0009da   0e80     MOVLW     0x80                     movlw     0x80                                                        C:\MCC18\SRC\TRADIT~1\MATH\castFP08.asm
