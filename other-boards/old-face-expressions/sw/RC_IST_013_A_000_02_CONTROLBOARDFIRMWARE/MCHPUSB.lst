                                           jMaxPos:                                                                        C:\MCC18\SRC\TRADIT~1\MATH\castFP08.asm
0009d4   0e7f     MOVLW     0x7f                     movlw     0x7F                                                        C:\MCC18\SRC\TRADIT~1\MATH\castFP08.asm
