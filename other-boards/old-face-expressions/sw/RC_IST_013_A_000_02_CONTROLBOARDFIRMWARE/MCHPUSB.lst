                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                           ; Proceedure: Use FSR0 for 'dest' and FSR2 for 'src'.                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                             ; Save FSR2 on the stack.                                                      C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                     Stk2PushFromReg FSR2L                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                             ; Load FSR2 with the 'src' pointer                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                     Stk2CpyToReg -6,FSR2L                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
