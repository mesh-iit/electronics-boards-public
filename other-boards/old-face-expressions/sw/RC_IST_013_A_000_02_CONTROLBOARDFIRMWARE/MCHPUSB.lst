                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ; @name memcpy                                                                   C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;``The {\bf memcpy} funciton copies {\bf n} characters from the object           C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;pointed to by {\bf s2} into the object pointed to by {\bf s1}. If               C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;copying takes place between objects that overlap, the behaviour is              C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;undefined.''                                                                    C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;Stack usage: 8 bytes. Re-entrant.                                               C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;@param s1 pointer to destination                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;@param s2 pointer to source                                                     C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;@param n count of bytes to copy                                                 C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;@return ``The {\bf memcpy} function returns the value of {\bf s1}.''            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;                                                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ; void *memcpy (void *s1, const void *s2, size_t n);                             C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           STRING CODE                                                                      C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           memcpy                                                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                             global memcpy                                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ; Proceedure: Use offset from top of stack to test 'n' for zero and decrement    C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           ;         it. Use FSR0 for 'dest' and FSR2 for 'src'                             C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                             ; Save FSR2 on the stack.                                                      C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                     Stk2PushFromReg FSR2L                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                             ; Load FSR2 with the 'src' pointer                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                     Stk2CpyToReg -6,FSR2L                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                             ; Load FSR0 with the 'dest' pointer                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                     Stk2CpyToReg -4,FSR0L                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                             ; Make a copy for the return value                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
0019f0   cfe9     MOVFF     0xfe9,0xff3    	  movff FSR0L, PRODL                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
0019f2   fff3                                                                                                               
0019f4   cfea     MOVFF     0xfea,0xff4    	  movff FSR0H, PRODH                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
0019f6   fff4                                                                                                               
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           jLoop:                                                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                             ; Test n for zero                                                              C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                     Stk2TestForZero -8,jEnd                                                C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                             ; Decrement n                                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                     Stk2Dec   -8                                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
001a0e   cfde     MOVFF     0xfde,0xfee              movff     POSTINC2, POSTINC0                                           C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
001a10   ffee                                                                                                               
001a12   d7f2     BRA       0x19f8                   bra       jLoop                                                        C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                           jEnd                                                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                             ; Restore stack frame for return: restore FSR2                                 C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                                     Stk2PopToReg FSR2L                                                     C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
001a24   0012     RETURN    0x0                      return                                                                 C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
                                             end                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\memcpy.asm
