                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                     Stk2CpyToReg -4,FSR0L                                                  C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                             ; make a copy for the return value                                             C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
                                                                                                                            C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
