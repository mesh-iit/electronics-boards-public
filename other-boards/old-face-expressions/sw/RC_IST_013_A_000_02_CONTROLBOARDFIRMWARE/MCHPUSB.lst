                                                                                                                           C:\MCC18\SRC\TRADIT~1\MATH\addFP.asm
                                                     braClr    fFlg,FLG_INF_B,jBANotInf                                    C:\MCC18\SRC\TRADIT~1\MATH\addFP.asm
