                                                                                                                           C:\MCC18\SRC\TRADIT~1\MATH\mulFP.asm
                                           ;; Sign is Flg.FLG_SIGN_ABW                                                     C:\MCC18\SRC\TRADIT~1\MATH\mulFP.asm
