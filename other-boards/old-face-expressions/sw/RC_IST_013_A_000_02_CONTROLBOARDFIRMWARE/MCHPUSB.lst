                                                       /*                                                                   D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * Control Read:                                                     D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * <SETUP[0]><IN[1]><IN[0]>...<OUT[1]> | <SETUP[0]>                  D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * 1. Prepare OUT EP to respond to early termination                 D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        *                                                                   D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * NOTE:                                                             D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * If something went wrong during the control transfer,              D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * the last status stage may not be sent by the host.                D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * When this happens, two different things could happen              D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * depending on the host.                                            D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * a) The host could send out a RESET.                               D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * b) The host could send out a new SETUP transaction                D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        *    without sending a RESET first.                                 D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * To properly handle case (b), the OUT EP must be setup             D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * to receive either a zero length OUT transaction, or a             D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * new SETUP transaction.                                            D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        *                                                                   D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * Since the SETUP transaction requires the DTS bit to be            D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * DAT0 while the zero length OUT status requires the DTS            D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * bit to be DAT1, the DTS bit check by the hardware should          D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * be disabled. This way the SIE could accept either of              D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * the two transactions.                                             D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        *                                                                   D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * Furthermore, the Cnt byte should be set to prepare for            D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * the SETUP data (8-byte or more), and the buffer address           D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        * should be pointed to SetupPkt.                                    D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
                                                        */                                                                  D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
001800   0104     MOVLB     0x4                        ep0Bo.Cnt = EP0_BUFF_SIZE;                                           D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
001802   0e08     MOVLW     0x8                                                                                             
001804   6f01     MOVWF     0x1,0x1                                                                                         
001806   0e20     MOVLW     0x20                       ep0Bo.ADR = (byte*)&SetupPkt;                                        D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
001808   6f02     MOVWF     0x2,0x1                                                                                         
00180a   0e04     MOVLW     0x4                                                                                             
00180c   6f03     MOVWF     0x3,0x1                                                                                         
00180e   0e80     MOVLW     0x80                       ep0Bo.Stat._byte = _USIE;           // Note: DTSEN is 0!             D:\PICs\ControlBoard\system\usb\usbctrltrf\usbctrltrf.c
001810   6f00     MOVWF     0x0,0x1                                                                                         
