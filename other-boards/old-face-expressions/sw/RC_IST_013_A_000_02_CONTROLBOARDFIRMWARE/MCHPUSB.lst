                                                     Stk2PopToReg FSR2L                                                     C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
001ae0   0012     RETURN    0x0                      return                                                                 C:\MCC18\SRC\TRADIT~1\STDCLIB\strcpy.asm
