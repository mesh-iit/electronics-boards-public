                                                                                                                           C:\MCC18\SRC\TRADIT~1\MATH\addFP.asm
                                           FPA32                                                                           C:\MCC18\SRC\TRADIT~1\MATH\addFP.asm
                                                                                                                           C:\MCC18\SRC\TRADIT~1\MATH\addFP.asm
                                           ;------ Unpack the operands                                                     C:\MCC18\SRC\TRADIT~1\MATH\addFP.asm
